# Copy to .env (never commit .env). Read by the API server only.

# Google OAuth "Web application" Client ID. Public value; no client secret is used.
GOOGLE_CLIENT_ID=

# Local only: shows a "Dev sign-in" button so you can test without Google.
# Ignored when NODE_ENV=production.
DEV_LOGIN=1

# Optional
# PORT=8787
# DATABASE_FILE=data/salesquest.db
